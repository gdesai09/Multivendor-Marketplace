<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>My Orders — Vendra</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --bg:#0d0b09;--surface:#141210;--card:#1a1714;--card-h:#1f1c18;
      --border:#2a2520;--amber:#d4843a;--amber-lt:#e8a862;--amber-dk:#a85f1e;
      --cream:#f0e8d8;--muted:#7a7068;--white:#f8f4ee;--green:#4caf7d;
      --sidebar-w:230px;--topbar-h:64px;
      --font-display:'Cormorant Garamond',serif;
      --font-body:'DM Sans',sans-serif;
      --ease:cubic-bezier(.22,.68,0,1.2);
    }
    body{background:var(--bg);color:var(--white);font-family:var(--font-body);font-size:14px;line-height:1.6;min-height:100vh;cursor:none;}
    .cursor{position:fixed;top:0;left:0;z-index:9999;pointer-events:none;}
    .cursor-dot{width:7px;height:7px;background:var(--amber);border-radius:50%;transform:translate(-50%,-50%);}
    .cursor-ring{position:absolute;top:0;left:0;width:32px;height:32px;border:1px solid rgba(212,132,58,.4);border-radius:50%;transform:translate(-50%,-50%);transition:width .3s var(--ease),height .3s var(--ease),border-color .25s;}
    body:has(a:hover,button:hover) .cursor-ring{width:46px;height:46px;border-color:var(--amber);}
    body::before{content:'';position:fixed;inset:0;z-index:0;opacity:.022;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");}
    ::-webkit-scrollbar{width:3px;}
    ::-webkit-scrollbar-track{background:var(--bg);}
    ::-webkit-scrollbar-thumb{background:var(--amber);border-radius:2px;}

    .topbar{position:fixed;top:0;left:0;right:0;z-index:200;height:var(--topbar-h);background:rgba(13,11,9,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 2rem 0 calc(var(--sidebar-w) + 2rem);gap:1rem;}
    .topbar-brand{font-family:var(--font-display);font-size:1.4rem;font-weight:600;color:var(--cream);position:absolute;left:2rem;text-decoration:none;}
    .topbar-brand span{color:var(--amber);}
    .topbar-page{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
    .topbar-right{margin-left:auto;display:flex;align-items:center;gap:1rem;}
    .topbar-avatar{display:flex;align-items:center;gap:.6rem;background:var(--card);border:1px solid var(--border);border-radius:8px;padding:.4rem .75rem .4rem .4rem;cursor:pointer;}
    .avatar-circle{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--amber-dk),var(--amber));display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:var(--bg);}
    .avatar-name{font-size:.75rem;font-weight:500;color:var(--cream);}

    .shell{display:flex;min-height:100vh;padding-top:var(--topbar-h);}

    .sidebar{position:fixed;top:var(--topbar-h);left:0;bottom:0;width:var(--sidebar-w);background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:100;}
    .sidebar-header{padding:1.8rem 1.4rem 1rem;border-bottom:1px solid var(--border);}
    .sidebar-label{font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--amber);display:block;margin-bottom:.2rem;}
    .sidebar-vendor{font-family:var(--font-display);font-size:1.1rem;color:var(--cream);}
    .vendor-status{display:inline-flex;align-items:center;gap:.4rem;margin-top:.6rem;padding:.2rem .6rem;background:rgba(76,175,125,.1);border:1px solid rgba(76,175,125,.2);border-radius:100px;font-size:.62rem;color:var(--green);letter-spacing:.06em;text-transform:uppercase;}
    .vendor-status::before{content:'';width:5px;height:5px;background:var(--green);border-radius:50%;animation:blink 2s infinite;}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
    .sidebar-nav{flex:1;padding:.8rem 0;}
    .nav-section-label{font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);padding:.8rem 1.4rem .4rem;}
    .menu-link{display:flex;align-items:center;gap:.75rem;padding:.65rem 1.4rem;color:var(--muted);text-decoration:none;font-size:.8rem;border-left:2px solid transparent;transition:color .2s,background .2s,border-color .2s;}
    .menu-link:hover{color:var(--cream);background:rgba(255,255,255,.04);}
    .menu-link.active{color:var(--amber-lt);border-left-color:var(--amber);background:rgba(212,132,58,.06);font-weight:500;}
    .nav-icon{width:18px;text-align:center;font-size:.9rem;}
    .sidebar-footer{padding:1rem 1.4rem;border-top:1px solid var(--border);}
    .sidebar-footer a{display:flex;align-items:center;gap:.65rem;color:var(--muted);text-decoration:none;font-size:.78rem;transition:color .2s;}
    .sidebar-footer a:hover{color:#e05;}

    .main{margin-left:var(--sidebar-w);flex:1;padding:2.5rem;min-width:0;}
    .page-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;}
    .page-title-eyebrow{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);display:block;margin-bottom:.3rem;}
    .page-title{font-family:var(--font-display);font-size:clamp(1.8rem,3vw,2.8rem);font-weight:300;line-height:1;color:var(--cream);}
    .page-title em{font-style:italic;color:var(--amber);}

    .filter-bar{display:flex;gap:.5rem;margin-bottom:1.5rem;flex-wrap:wrap;}
    .filter-btn{padding:.4rem 1rem;background:transparent;border:1px solid var(--border);border-radius:100px;color:var(--muted);font-family:var(--font-body);font-size:.72rem;cursor:pointer;transition:all .2s;}
    .filter-btn:hover,.filter-btn.active{border-color:var(--amber);color:var(--amber);background:rgba(212,132,58,.08);}

    .panel{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .panel-header{padding:1.3rem 1.6rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    .panel-title{font-family:var(--font-display);font-size:1.15rem;color:var(--cream);}

    .orders-table{width:100%;border-collapse:collapse;}
    .orders-table th{padding:.7rem 1.2rem;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-align:left;border-bottom:1px solid var(--border);}
    .orders-table td{padding:1rem 1.2rem;border-bottom:1px solid rgba(42,37,32,.6);vertical-align:middle;font-size:.82rem;}
    .orders-table tr:last-child td{border-bottom:none;}
    .orders-table tbody tr{transition:background .2s;}
    .orders-table tbody tr:hover{background:rgba(255,255,255,.025);}

    .pill{display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .65rem;border-radius:100px;font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;font-weight:600;}
    .pill::before{content:'';width:5px;height:5px;border-radius:50%;}
    .pill-placed{background:rgba(80,140,240,.1);color:#5a8ef0;border:1px solid rgba(80,140,240,.2);}
    .pill-placed::before{background:#5a8ef0;}
    .pill-processing{background:rgba(212,132,58,.12);color:var(--amber);border:1px solid rgba(212,132,58,.2);}
    .pill-processing::before{background:var(--amber);}
    .pill-shipped{background:rgba(160,100,220,.12);color:#b06ee0;border:1px solid rgba(160,100,220,.2);}
    .pill-shipped::before{background:#b06ee0;}
    .pill-delivered{background:rgba(76,175,125,.12);color:var(--green);border:1px solid rgba(76,175,125,.2);}
    .pill-delivered::before{background:var(--green);}
    .pill-cancelled{background:rgba(220,60,60,.1);color:#e05;border:1px solid rgba(220,60,60,.2);}
    .pill-cancelled::before{background:#e05;}
    .pill-muted{background:rgba(122,112,104,.1);color:var(--muted);border:1px solid var(--border);}
    .pill-muted::before{background:var(--muted);}

    .cust-name{color:var(--cream);font-weight:500;}
    .cust-email{font-size:.72rem;color:var(--muted);}
    .order-id{font-family:monospace;font-size:.75rem;color:var(--muted);}
    .order-amount{font-family:var(--font-display);font-size:1.1rem;color:var(--cream);}

    .btn-update{background:transparent;border:1px solid var(--border);border-radius:5px;padding:.3rem .7rem;color:var(--muted);font-family:var(--font-body);font-size:.68rem;cursor:pointer;transition:border-color .2s,color .2s;}
    .btn-update:hover{border-color:var(--amber);color:var(--amber);}

    .empty{padding:4rem;text-align:center;color:var(--muted);}
    .empty p{font-family:var(--font-display);font-size:1.3rem;margin-bottom:.3rem;}

    .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:500;display:none;align-items:center;justify-content:center;}
    .modal-overlay.open{display:flex;}
    .modal{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:2rem;width:100%;max-width:420px;position:relative;}
    .modal-title{font-family:var(--font-display);font-size:1.3rem;color:var(--cream);margin-bottom:1.5rem;}
    .modal label{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:.4rem;}
    .modal select,.modal input{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:.55rem .8rem;color:var(--white);font-family:var(--font-body);font-size:.82rem;outline:none;margin-bottom:1rem;}
    .modal select:focus,.modal input:focus{border-color:var(--amber);}
    .btn-primary{padding:.65rem 1.5rem;background:var(--amber);color:var(--bg);border:none;border-radius:6px;font-family:var(--font-body);font-size:.75rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;width:100%;transition:background .2s;}
    .btn-primary:hover{background:var(--amber-lt);}
    .modal-msg{font-size:.75rem;text-align:center;min-height:1rem;margin-top:.5rem;}
    .modal-close{position:absolute;top:1rem;right:1rem;background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer;width:auto;padding:.2rem .5rem;}
    .modal-close:hover{color:var(--white);}

    .items-list{background:var(--surface);border-radius:6px;padding:.8rem;margin-bottom:1rem;max-height:150px;overflow-y:auto;}
    .item-row{display:flex;justify-content:space-between;font-size:.78rem;padding:.3rem 0;border-bottom:1px solid var(--border);}
    .item-row:last-child{border-bottom:none;}
    .item-name{color:var(--cream);}
    .item-price{color:var(--amber);}

    footer{background:var(--surface);border-top:1px solid var(--border);position:relative;z-index:1;}
    .footer-inner{padding:1.5rem 2.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;}
    .footer-brand{font-family:var(--font-display);font-size:1rem;color:var(--cream);}
    .footer-brand span{color:var(--amber);}
    .footer-copy{font-size:.68rem;color:var(--muted);}
  </style>
</head>
<body>

  <div class="cursor" id="cursor">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
  </div>

  <header class="topbar">
    <a href="/" class="topbar-brand">Vend<span>◆</span>ra</a>
    <div style="width:1px;height:20px;background:var(--border)"></div>
    <span class="topbar-page">My Orders</span>
    <div class="topbar-right">
      <div class="topbar-avatar">
        <div class="avatar-circle">V</div>
        <span class="avatar-name">Vendor</span>
      </div>
    </div>
  </header>

  <div class="shell">

    <nav class="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-label">Logged in as</span>
        <div class="sidebar-vendor">My Store</div>
        <div class="vendor-status">Active</div>
      </div>
      <div class="sidebar-nav">
        <div class="nav-section-label">Main</div>
        <a href="/vendor"             class="menu-link"><span class="nav-icon">⊞</span> Dashboard</a>
        <a href="/vendor/additem"     class="menu-link"><span class="nav-icon">＋</span> Add Product</a>
        <a href="/vendor/my-products" class="menu-link"><span class="nav-icon">◫</span> My Products</a>
        <div class="nav-section-label" style="margin-top:.5rem">Store</div>
        <a href="/vendor/orders"      class="menu-link active"><span class="nav-icon">◎</span> Orders</a>
        <a href="#"                   class="menu-link"><span class="nav-icon">◈</span> Analytics</a>
        <a href="#"                   class="menu-link"><span class="nav-icon">◉</span> Settings</a>
      </div>
      <div class="sidebar-footer">
        <a href="/vendor/logout">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75"/>
          </svg>
          Log Out
        </a>
      </div>
    </nav>

    <main class="main">
      <div class="page-header">
        <div>
          <span class="page-title-eyebrow">Store</span>
          <h1 class="page-title">My <em>Orders</em></h1>
        </div>
        <div style="font-size:.78rem;color:var(--muted)">
          <%= orders.length %> order<%= orders.length !== 1 ? 's' : '' %> total
        </div>
      </div>

      <div class="filter-bar">
        <button class="filter-btn active" onclick="filterOrders(this,'')">All</button>
        <button class="filter-btn" onclick="filterOrders(this,'Order Placed')">Placed</button>
        <button class="filter-btn" onclick="filterOrders(this,'Processing')">Processing</button>
        <button class="filter-btn" onclick="filterOrders(this,'Shipped')">Shipped</button>
        <button class="filter-btn" onclick="filterOrders(this,'Delivered')">Delivered</button>
        <button class="filter-btn" onclick="filterOrders(this,'Cancelled')">Cancelled</button>
      </div>

      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">Order <em style="font-style:italic;color:var(--amber)">List</em></span>
          <span style="font-size:.7rem;color:var(--muted)" id="filter-label">Showing all</span>
        </div>

        <table class="orders-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Items</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="orders-body">
            <% if (orders.length === 0) { %>
              <tr>
                <td colspan="7">
                  <div class="empty">
                    <p>No orders yet</p>
                    <span>Orders will appear here once customers purchase your products</span>
                  </div>
                </td>
              </tr>
            <% } %>
            <% orders.forEach(o => { %>
              <% const pillClass =
                  o.status === 'Delivered'        ? 'pill-delivered'  :
                  o.status === 'Shipped'          ? 'pill-shipped'    :
                  o.status === 'Out for Delivery' ? 'pill-shipped'    :
                  o.status === 'Processing'       ? 'pill-processing' :
                  o.status === 'Packed'           ? 'pill-processing' :
                  o.status === 'Cancelled'        ? 'pill-cancelled'  :
                  'pill-placed'; %>
              <tr data-status="<%= o.status %>">
                <td class="order-id">#<%= o._id.toString().slice(-8).toUpperCase() %></td>
                <td>
                  <div class="cust-name"><%= o.userId?.name || 'Unknown' %></div>
                  <div class="cust-email"><%= o.userId?.email || '' %></div>
                  <div class="cust-email"><%= o.customerDetails?.city %>, <%= o.customerDetails?.pincode %></div>
                </td>
                <td>
                  <div style="font-size:.78rem;color:var(--muted)">
                    <%= o.items.length %> item<%= o.items.length !== 1 ? 's' : '' %>
                  </div>
                  <button class="btn-update" style="margin-top:.3rem"
                    onclick='showItems(<%- JSON.stringify(o.items) %>)'>
                    View Items
                  </button>
                </td>
                <td class="order-amount">₹<%= o.totalAmount.toLocaleString('en-IN') %></td>
                <td><span class="pill <%= pillClass %>"><%= o.status %></span></td>
                <td style="color:var(--muted);font-size:.75rem">
                  <%= new Date(o.createdAt).toLocaleDateString('en-IN') %>
                </td>
                <td>
                  <button class="btn-update"
                    onclick="openModal('<%= o._id %>','<%= o.status %>')">
                    Update
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- UPDATE STATUS MODAL -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <button class="modal-close" onclick="closeModal()">✕</button>
      <div class="modal-title">Update <em style="font-style:italic;color:var(--amber)">Status</em></div>
      <label>Order ID</label>
      <input type="text" id="modal-order-id" readonly style="color:var(--muted);cursor:not-allowed"/>
      <label>New Status</label>
      <select id="modal-status">
        <option value="">— select —</option>
        <option>Processing</option>
        <option>Order Placed</option>
        <option>Packed</option>
        <option>Shipped</option>
        <option>Out for Delivery</option>
        <option>Delivered</option>
        <option>Cancelled</option>
      </select>
      <label>Note (optional)</label>
      <input type="text" id="modal-note" placeholder="e.g. Dispatched via BlueDart"/>
      <button class="btn-primary" onclick="submitUpdate()">Push Update</button>
      <div class="modal-msg" id="modal-msg"></div>
    </div>
  </div>

  <!-- VIEW ITEMS MODAL -->
  <div class="modal-overlay" id="items-modal">
    <div class="modal">
      <button class="modal-close" onclick="closeItemsModal()">✕</button>
      <div class="modal-title">Order <em style="font-style:italic;color:var(--amber)">Items</em></div>
      <div class="items-list" id="items-list"></div>
      <button class="btn-primary" onclick="closeItemsModal()">Close</button>
    </div>
  </div>

  <footer>
    <div class="footer-inner">
      <div class="footer-brand">Vend<span>◆</span>ra</div>
      <div class="footer-copy">© 2026 Multi Vendor Marketplace</div>
    </div>
  </footer>

  <script>
    const cur  = document.getElementById('cursor');
    const dot  = cur.querySelector('.cursor-dot');
    const ring = cur.querySelector('.cursor-ring');
    let mx=0,my=0,rx=0,ry=0;
    document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
    (function anim(){
      dot.style.cssText=`left:${mx}px;top:${my}px`;
      rx+=(mx-rx)*.13;ry+=(my-ry)*.13;
      ring.style.cssText=`left:${rx}px;top:${ry}px`;
      requestAnimationFrame(anim);
    })();

    function filterOrders(btn, status) {
      document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      const rows  = document.querySelectorAll('#orders-body tr[data-status]');
      const label = document.getElementById('filter-label');
      let visible = 0;
      rows.forEach(row=>{
        const match = status==='' || row.dataset.status===status;
        row.style.display = match ? '' : 'none';
        if(match) visible++;
      });
      label.textContent = status==='' ? 'Showing all' : `Showing ${visible} — ${status}`;
    }

    function openModal(orderId, currentStatus) {
      document.getElementById('modal-order-id').value  = orderId;
      document.getElementById('modal-status').value    = currentStatus;
      document.getElementById('modal-note').value      = '';
      document.getElementById('modal-msg').textContent = '';
      document.getElementById('modal').classList.add('open');
    }

    function closeModal() {
      document.getElementById('modal').classList.remove('open');
    }

    async function submitUpdate() {
      const orderId = document.getElementById('modal-order-id').value;
      const status  = document.getElementById('modal-status').value;
      const note    = document.getElementById('modal-note').value.trim();
      const msg     = document.getElementById('modal-msg');

      if (!status) {
        msg.style.color = '#e05';
        msg.textContent = 'Please select a status ❌';
        return;
      }

      const res  = await fetch('/vendor/update-tracking', {
        method:      'PATCH',
        headers:     { 'Content-Type': 'application/json' },
        credentials: 'include',
        body:        JSON.stringify({ orderId, status, note }),
      });
      const data = await res.json();
      msg.style.color = res.ok ? 'var(--green)' : '#e05';
      msg.textContent = data.message;

      if (res.ok) {
        setTimeout(()=>{ closeModal(); window.location.reload(); }, 1000);
      }
    }

    function showItems(items) {
      const list = document.getElementById('items-list');
      list.innerHTML = items.map(item=>`
        <div class="item-row">
          <span class="item-name">${item.name} × ${item.quantity||1}</span>
          <span class="item-price">₹${Number(item.price).toLocaleString('en-IN')}</span>
        </div>`).join('');
      document.getElementById('items-modal').classList.add('open');
    }

    function closeItemsModal() {
      document.getElementById('items-modal').classList.remove('open');
    }

    document.getElementById('modal').addEventListener('click',function(e){
      if(e.target===this) closeModal();
    });
    document.getElementById('items-modal').addEventListener('click',function(e){
      if(e.target===this) closeItemsModal();
    });
  </script>

</body>
</html>