<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Orders — Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <%- include('partials/style') %>
</head>
<body>
  <%- include('partials/sidebar', { active: 'orders' }) %>

  <main class="main">
    <div class="page-header">
      <div>
        <span class="eyebrow">Management</span>
        <h1 class="page-title">All <em>Orders</em></h1>
      </div>
    </div>

    <div class="panel">
      <table class="table">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Shop</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (orders.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:2rem">No orders found</td></tr>
          <% } %>
          <% orders.forEach(o => { %>
          <tr>
            <td style="font-family:monospace;font-size:.75rem;color:var(--muted)">
              <%= o._id.toString().slice(-8).toUpperCase() %>
            </td>
            <td>
              <div style="color:var(--cream)"><%= o.userId?.name || '—' %></div>
              <div style="font-size:.72rem;color:var(--muted)"><%= o.userId?.email || '' %></div>
            </td>
            <td style="color:var(--amber)"><%= o.vendorId?.shopName || o.shopName %></td>
            <td style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;color:var(--cream)">
              ₹<%= o.totalAmount.toLocaleString('en-IN') %>
            </td>
            <td>
              <span class="pill
                <%= o.status === 'Delivered'       ? 'pill-green' :
                    o.status === 'Cancelled'        ? 'pill-red'   :
                    o.status === 'Out for Delivery' ? 'pill-amber' :
                    'pill-muted' %>">
                <%= o.status %>
              </span>
            </td>
            <td style="font-size:.78rem;color:var(--muted)">
              <%= new Date(o.createdAt).toLocaleDateString('en-IN') %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>