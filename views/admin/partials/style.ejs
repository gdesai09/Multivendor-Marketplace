<style>
  *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
  :root{
    --bg:#0d0b09;--surface:#141210;--card:#1a1714;--card-h:#1f1c18;
    --border:#2a2520;--amber:#d4843a;--amber-lt:#e8a862;
    --cream:#f0e8d8;--muted:#7a7068;--white:#f8f4ee;--green:#4caf7d;
    --sidebar-w:220px;
    --font-display:'Cormorant Garamond',serif;
    --font-body:'DM Sans',sans-serif;
  }
  body{background:var(--bg);color:var(--white);font-family:var(--font-body);font-size:14px;line-height:1.6;}

  /* shell */
  .shell{display:flex;min-height:100vh;}

  /* sidebar */
  .sidebar{
    width:var(--sidebar-w);background:var(--surface);
    border-right:1px solid var(--border);
    display:flex;flex-direction:column;
    position:fixed;top:0;left:0;bottom:0;
    padding:1.5rem 0;
  }
  .sidebar-brand{
    font-family:var(--font-display);font-size:1.4rem;
    font-weight:600;color:var(--cream);
    padding:0 1.4rem;margin-bottom:.2rem;
  }
  .sidebar-brand span{color:var(--amber);}
  .sidebar-sub{font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--amber);padding:0 1.4rem;margin-bottom:1.8rem;}
  .sidebar-nav{flex:1;display:flex;flex-direction:column;gap:.2rem;padding:0 .8rem;}
  .menu-link{
    display:flex;align-items:center;gap:.7rem;
    padding:.65rem .8rem;border-radius:6px;
    color:var(--muted);text-decoration:none;
    font-size:.8rem;font-weight:400;
    transition:color .2s,background .2s;
  }
  .menu-link:hover{color:var(--cream);background:rgba(255,255,255,.04);}
  .menu-link.active{color:var(--amber-lt);background:rgba(212,132,58,.08);font-weight:500;}
  .sidebar-footer{padding:1rem 1.4rem;border-top:1px solid var(--border);}
  .sidebar-footer a{display:flex;align-items:center;gap:.6rem;color:var(--muted);text-decoration:none;font-size:.78rem;transition:color .2s;}
  .sidebar-footer a:hover{color:#e05;}

  /* main */
  .main{margin-left:var(--sidebar-w);flex:1;padding:2.5rem;min-width:0;}

  /* page header */
  .page-header{margin-bottom:2rem;}
  .eyebrow{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);display:block;margin-bottom:.3rem;}
  .page-title{font-family:var(--font-display);font-size:2.4rem;font-weight:300;color:var(--cream);line-height:1;}
  .page-title em{font-style:italic;color:var(--amber);}

  /* stat grid */
  .stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:2rem;}
  .stat-card{background:var(--card);padding:1.6rem 1.4rem;transition:background .2s;}
  .stat-card:hover{background:var(--card-h);}
  .stat-icon{font-size:1.2rem;margin-bottom:.8rem;}
  .stat-label{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;}
  .stat-value{font-family:var(--font-display);font-size:2rem;font-weight:600;color:var(--cream);}

  /* quick links */
  .quick-links{display:flex;flex-direction:column;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
  .ql-card{display:flex;align-items:center;gap:1rem;padding:1.2rem 1.4rem;background:var(--card);text-decoration:none;transition:background .2s;}
  .ql-card:hover{background:var(--card-h);}
  .ql-icon{font-size:1.2rem;flex-shrink:0;}
  .ql-title{font-size:.85rem;color:var(--cream);font-weight:500;}
  .ql-sub{font-size:.72rem;color:var(--muted);}
  .ql-arrow{margin-left:auto;color:var(--muted);font-size:1.2rem;transition:color .2s,transform .2s;}
  .ql-card:hover .ql-arrow{color:var(--amber);transform:translateX(3px);}

  /* panel / table */
  .panel{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
  .table{width:100%;border-collapse:collapse;}
  .table th{padding:.7rem 1.2rem;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-align:left;border-bottom:1px solid var(--border);}
  .table td{padding:.9rem 1.2rem;border-bottom:1px solid rgba(42,37,32,.5);vertical-align:middle;font-size:.82rem;}
  .table tbody tr:last-child td{border-bottom:none;}
  .table tbody tr:hover{background:rgba(255,255,255,.02);}

  /* pills */
  .pill{display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .65rem;border-radius:100px;font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;font-weight:600;}
  .pill::before{content:'';width:5px;height:5px;border-radius:50%;}
  .pill-green{background:rgba(76,175,125,.12);color:var(--green);border:1px solid rgba(76,175,125,.2);}
  .pill-green::before{background:var(--green);}
  .pill-red{background:rgba(220,60,60,.1);color:#e05;border:1px solid rgba(220,60,60,.2);}
  .pill-red::before{background:#e05;}
  .pill-amber{background:rgba(212,132,58,.12);color:var(--amber);border:1px solid rgba(212,132,58,.2);}
  .pill-amber::before{background:var(--amber);}
  .pill-muted{background:rgba(122,112,104,.1);color:var(--muted);border:1px solid var(--border);}
  .pill-muted::before{background:var(--muted);}

  /* action buttons */
  .actions{display:flex;gap:.5rem;flex-wrap:wrap;}
  .btn-action{padding:.3rem .8rem;border:none;border-radius:5px;font-family:var(--font-body);font-size:.7rem;font-weight:600;cursor:pointer;transition:opacity .2s;letter-spacing:.04em;text-transform:uppercase;width:auto;height:auto;}
  .btn-green{background:rgba(76,175,125,.15);color:var(--green);}
  .btn-green:hover{background:rgba(76,175,125,.3);}
  .btn-red{background:rgba(220,60,60,.12);color:#e05;}
  .btn-red:hover{background:rgba(220,60,60,.25);}
  .btn-amber{background:rgba(212,132,58,.12);color:var(--amber);}
  .btn-amber:hover{background:rgba(212,132,58,.25);}
</style>