<!doctype html>
<html lang="en">
<head>
  <title>Track Order — Vendra</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/CSS/style.css" />
  <style>
    .track-wrap {
      max-width: 680px; margin: 0 auto;
      padding: 3rem 2rem 5rem;
      position: relative; z-index: 1;
    }

    /* ── ORDER SUMMARY CARD ── */
    .order-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; overflow: hidden; margin-bottom: 2rem;
    }
    .order-card-header {
      padding: 1.4rem 1.6rem; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: .8rem;
    }
    .order-id-label {
      font-size: .62rem; letter-spacing: .14em;
      text-transform: uppercase; color: var(--amber); display: block; margin-bottom: .2rem;
    }
    .order-id-val {
      font-family: var(--font-display); font-size: 1.1rem;
      color: var(--cream); word-break: break-all;
    }
    .order-status-badge {
      padding: .35rem .9rem; border-radius: 100px;
      font-size: .68rem; font-weight: 600; letter-spacing: .08em;
      text-transform: uppercase;
      background: rgba(212,132,58,.12);
      border: 1px solid rgba(212,132,58,.25);
      color: var(--amber);
    }
    .order-status-badge.delivered {
      background: rgba(76,175,125,.12); border-color: rgba(76,175,125,.25); color: var(--green);
    }
    .order-status-badge.cancelled {
      background: rgba(224,80,80,.1); border-color: rgba(224,80,80,.2); color: var(--error);
    }

    .order-meta {
      padding: 1.2rem 1.6rem; display: flex; gap: 2rem; flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
    }
    .meta-item { }
    .meta-label {
      font-size: .6rem; letter-spacing: .1em; text-transform: uppercase;
      color: var(--muted); display: block; margin-bottom: .2rem;
    }
    .meta-val { font-size: .88rem; color: var(--cream); }

    /* ── ORDER ITEMS ── */
    .order-items { padding: 1.2rem 1.6rem; }
    .order-item {
      display: flex; align-items: center; gap: 1rem;
      padding: .8rem 0; border-bottom: 1px solid rgba(42,37,32,.5);
    }
    .order-item:last-child { border-bottom: none; }
    .order-item-img {
      width: 52px; height: 52px; border-radius: 7px;
      background: var(--surface); overflow: hidden; flex-shrink: 0;
    }
    .order-item-img img { width: 100%; height: 100%; object-fit: cover; }
    .order-item-name {
      font-family: var(--font-display); font-size: 1rem; color: var(--cream); flex: 1;
    }
    .order-item-qty { font-size: .75rem; color: var(--muted); }
    .order-item-price {
      font-family: var(--font-display); font-size: 1rem;
      font-weight: 600; color: var(--amber);
    }

    .order-total-row {
      padding: 1rem 1.6rem;
      display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid var(--border);
      background: rgba(212,132,58,.04);
    }
    .order-total-label { font-size: .78rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
    .order-total-val {
      font-family: var(--font-display); font-size: 1.4rem;
      font-weight: 600; color: var(--amber);
    }

    /* ── TRACKING TIMELINE ── */
    .timeline-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; overflow: hidden; margin-bottom: 2rem;
    }
    .timeline-header {
      padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--border);
    }
    .timeline-title {
      font-family: var(--font-display); font-size: 1.2rem;
      font-weight: 300; color: var(--cream);
    }
    .timeline-title em { font-style: italic; color: var(--amber); }

    .timeline { padding: 1.4rem 1.6rem; display: flex; flex-direction: column; gap: 0; }
    .timeline-step {
      display: flex; gap: 1rem; position: relative;
    }
    .timeline-step:not(:last-child)::before {
      content: '';
      position: absolute; left: 11px; top: 28px;
      width: 2px; bottom: -8px;
      background: var(--border);
    }
    .step-dot {
      width: 24px; height: 24px; border-radius: 50%; flex-shrink: 0;
      border: 2px solid var(--border); background: var(--surface);
      display: flex; align-items: center; justify-content: center;
      margin-top: 2px; position: relative; z-index: 1;
    }
    .step-dot.active {
      border-color: var(--amber); background: var(--amber);
    }
    .step-dot.active::after {
      content: '✓'; font-size: .6rem; color: var(--bg); font-weight: 700;
    }
    .step-body { padding-bottom: 1.5rem; flex: 1; }
    .step-status {
      font-size: .82rem; font-weight: 600; color: var(--cream); margin-bottom: .15rem;
    }
    .step-note { font-size: .72rem; color: var(--muted); }
    .step-time { font-size: .65rem; color: var(--muted); margin-top: .2rem; letter-spacing: .04em; }

    /* ── DELIVERY DETAILS ── */
    .delivery-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; overflow: hidden; margin-bottom: 2rem;
    }
    .delivery-header {
      padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--border);
      font-family: var(--font-display); font-size: 1.1rem; color: var(--cream);
    }
    .delivery-body {
      padding: 1.2rem 1.6rem; display: flex; flex-direction: column; gap: .6rem;
    }
    .delivery-row { display: flex; gap: 1rem; }
    .delivery-lbl { font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); min-width: 80px; }
    .delivery-val { font-size: .85rem; color: var(--cream); }

    /* ── ACTIONS ── */
    .track-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-outline {
      padding: .7rem 1.5rem; background: transparent;
      border: 1px solid var(--border); border-radius: 6px;
      color: var(--muted); font-family: var(--font-body);
      font-size: .78rem; font-weight: 500; letter-spacing: .06em;
      text-transform: uppercase; cursor: pointer; text-decoration: none;
      display: inline-flex; align-items: center; gap: .4rem;
      transition: border-color .2s, color .2s;
    }
    .btn-outline:hover { border-color: var(--amber); color: var(--amber); }
  </style>
</head>

<body>

  <!-- CURSOR -->
  <div class="cursor" id="cursor">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
  </div>

  <!-- NAV -->
  <header>
    <nav class="navbar">
      <a href="/" class="nav-brand">Vend<span>◆</span>ra</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/cart">Cart</a></li>
        <li><a href="/track" class="active">Track Order</a></li>
      </ul>
    </nav>
  </header>

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-grid"></div>
    <div class="page-hero-eyebrow">Order Status</div>
    <h1>Track your <em>Order</em></h1>
    <p class="page-hero-sub">Real-time updates on your delivery.</p>
  </div>

  <div class="track-wrap">

    <!-- ORDER SUMMARY -->
    <div class="order-card">
      <div class="order-card-header">
        <div>
          <span class="order-id-label">Order ID</span>
          <span class="order-id-val"><%= order._id %></span>
        </div>
        <span class="order-status-badge <%= order.status === 'Delivered' ? 'delivered' : order.status === 'Cancelled' ? 'cancelled' : '' %>">
          <%= order.status %>
        </span>
      </div>

      <div class="order-meta">
        <div class="meta-item">
          <span class="meta-label">Shop</span>
          <span class="meta-val"><%= order.shopName %></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Placed On</span>
          <span class="meta-val"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Payment</span>
          <span class="meta-val"><%= order.customerDetails?.payment || 'COD' %></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Items</span>
          <span class="meta-val"><%= order.items.length %></span>
        </div>
      </div>

      <!-- ORDER ITEMS -->
      <div class="order-items">
        <% order.items.forEach(item => { %>
        <div class="order-item">
          <div class="order-item-img">
            <% if (item.image) { %>
            <img src="<%= item.image %>" alt="<%= item.name %>" />
            <% } %>
          </div>
          <div class="order-item-name"><%= item.name %></div>
          <div class="order-item-qty">× <%= item.quantity %></div>
          <div class="order-item-price">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></div>
        </div>
        <% }) %>
      </div>

      <div class="order-total-row">
        <span class="order-total-label">Total Amount</span>
        <span class="order-total-val">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
      </div>
    </div>

    <!-- TRACKING TIMELINE -->
    <div class="timeline-card">
      <div class="timeline-header">
        <div class="timeline-title">Delivery <em>Timeline</em></div>
      </div>
      <div class="timeline">
        <% if (order.tracking && order.tracking.length > 0) { %>
          <% order.tracking.forEach((step, i) => { %>
          <div class="timeline-step">
            <div class="step-dot active"></div>
            <div class="step-body">
              <div class="step-status"><%= step.status %></div>
              <% if (step.note) { %>
              <div class="step-note"><%= step.note %></div>
              <% } %>
              <div class="step-time"><%= new Date(step.updatedAt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></div>
            </div>
          </div>
          <% }) %>
        <% } else { %>
          <div class="timeline-step">
            <div class="step-dot active"></div>
            <div class="step-body">
              <div class="step-status">Order Placed</div>
              <div class="step-note">Your order has been received.</div>
              <div class="step-time"><%= new Date(order.createdAt).toLocaleString('en-IN') %></div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- DELIVERY DETAILS -->
    <div class="delivery-card">
      <div class="delivery-header">Delivery Details</div>
      <div class="delivery-body">
        <div class="delivery-row">
          <span class="delivery-lbl">Name</span>
          <span class="delivery-val"><%= order.customerDetails?.name %></span>
        </div>
        <div class="delivery-row">
          <span class="delivery-lbl">Address</span>
          <span class="delivery-val"><%= order.customerDetails?.address %>, <%= order.customerDetails?.city %> — <%= order.customerDetails?.pincode %></span>
        </div>
      </div>
    </div>

    <!-- ACTIONS -->
    <div class="track-actions">
      <a href="/products" class="btn-outline">← Continue Shopping</a>
      <a href="/track" class="btn-outline">Track Another Order</a>
    </div>

  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-brand">Vend<span>◆</span>ra</div>
      <div class="footer-copy">© 2026 Multi Vendor Marketplace</div>
    </div>
  </footer>

  <script src="/js/script.js"></script>
</body>
</html>
