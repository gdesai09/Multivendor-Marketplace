<!doctype html>
<html>
  <head>
    <title>Products</title>
    <link rel="stylesheet" href="/CSS/style.css" />
  </head>

  <body>
    <h2>Products</h2>
    <hr />
    <header>
      <nav class="product-nav">
<div class="category-grid">

<div class="category-card">
<img src="/static/images/electronics.png">
<p><a href="products.html?category=Electronics">Electronics</a></p>
</div>

<div class="category-card">
<img src="/static/images/clothing.png">
<p><a href="products.html?category=Clothing">Clothing</a></p>
</div>

<div class="category-card">
<img src="/static/images/books.png">
<p><a href="products.html?category=Books">Books</a></p>
</div>

<div class="category-card">
<img src="/static/images/kitchen.png">
<p><a href="products.html?category=Home & Kitchen">Home & Kitchen</a></p>
</div>

<div class="category-card">
<img src="/static/images/accessories.png">
<p><a href="products.html?category=electronics">Accessories</a></p>
</div>

</div>
    </nav>
    </header>
    <hr />
    <div class="features">
      <div class="features">

  <% products.forEach(product => { %>

    <div class="card">
      <img src="<%= product.image %>" width="200" />

      <p><%= product.name %></p>

      <p>₹<%= product.price %></p>

      <button
        onclick="addToCart('<%= product.name %>','<%= product.price %>','<%= product.image %>')"
      >
        Add to Cart
      </button>
    </div>

  <% }) %>

</div>
    </div>

    <div class="features" id="product-list"></div>

    <footer>
      <p>© 2026 Multi Vendor Marketplace</p>
    </footer>
    <script src="/js/script.js"></script>
  </body>
</html>
