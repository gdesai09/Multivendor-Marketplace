<!doctype html>
<html lang="en">
<head>
  <title>Products — Vendra</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/CSS/style.css" />
  <style>
    /* ── PAGE HERO ── */
    .page-hero{position:relative;padding:8rem 2rem 4rem;text-align:center;overflow:hidden;background:var(--bg);}
    .page-hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(212,132,58,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(212,132,58,.04) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 30%,transparent 80%);}
    .page-hero-eyebrow{display:inline-block;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--amber);background:rgba(212,132,58,.1);border:1px solid rgba(212,132,58,.25);border-radius:100px;padding:.3rem .9rem;margin-bottom:1.2rem;}
    .page-hero h1{font-family:var(--font-display);font-size:clamp(2.4rem,6vw,5rem);font-weight:300;color:var(--cream);line-height:1;margin-bottom:1rem;}
    .page-hero h1 em{font-style:italic;color:var(--amber);}
    .page-hero-sub{color:var(--muted);font-size:1rem;max-width:480px;margin:0 auto;}

    /* ── TOOLBAR ── */
    .toolbar-wrap{position:sticky;top:0;z-index:50;background:rgba(13,11,9,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);}
    .toolbar{max-width:1320px;margin:0 auto;padding:.8rem 2rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;}
    .search-wrap{position:relative;flex:1;min-width:200px;}
    .search-input{width:100%;background:var(--card);border:1px solid var(--border);border-radius:6px;padding:.5rem .8rem .5rem 2.2rem;color:var(--white);font-family:var(--font-body);font-size:.82rem;outline:none;transition:border-color .2s;}
    .search-input:focus{border-color:var(--amber);}
    .sort-select{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:.5rem .8rem;color:var(--muted);font-family:var(--font-body);font-size:.78rem;outline:none;cursor:pointer;}
    .result-count{font-size:.72rem;color:var(--muted);white-space:nowrap;margin-left:auto;}

    /* ── LAYOUT ── */
    .layout{display:grid;grid-template-columns:240px 1fr;gap:2rem;max-width:1320px;margin:0 auto;padding:2rem;}

    /* ── SIDEBAR ── */
    .sidebar{position:sticky;top:56px;height:fit-content;}
    .sidebar-section{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.2rem;margin-bottom:1rem;}
    .sidebar-heading{font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);margin-bottom:.8rem;}
    .cat-list{display:flex;flex-direction:column;gap:.2rem;}
    .cat-item{display:block;padding:.5rem .7rem;color:var(--muted);text-decoration:none;font-size:.8rem;border-radius:5px;border-left:2px solid transparent;transition:color .2s,background .2s,border-color .2s;}
    .cat-item:hover{color:var(--cream);background:rgba(255,255,255,.04);}
    .cat-item.active{color:var(--amber-lt);border-left-color:var(--amber);background:rgba(212,132,58,.06);}
    .price-slider{width:100%;accent-color:var(--amber);margin:.5rem 0;}
    .price-labels{display:flex;justify-content:space-between;font-size:.68rem;color:var(--muted);}

    /* ── CAT STRIP ── */
    .cat-strip{display:flex;gap:.8rem;overflow-x:auto;padding-bottom:.5rem;margin-bottom:1.5rem;scrollbar-width:none;}
    .cat-strip::-webkit-scrollbar{display:none;}
    .cat-card{display:flex;flex-direction:column;align-items:center;gap:.4rem;padding:.8rem 1.2rem;background:var(--card);border:1px solid var(--border);border-radius:10px;text-decoration:none;min-width:90px;transition:border-color .2s,background .2s;flex-shrink:0;}
    .cat-card:hover{border-color:var(--amber);background:var(--card-h);}
    .cat-card-icon{font-size:1.4rem;}
    .cat-card-label{font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);}

    /* ── PRODUCT GRID ── */
    .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.5rem;}
    .product-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;position:relative;transition:all .3s ease;}
    .product-card:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(0,0,0,.3);border-color:rgba(212,132,58,.3);}
    .product-wish{position:absolute;top:10px;right:10px;background:rgba(13,11,9,.7);border:1px solid var(--border);color:var(--white);padding:5px 8px;border-radius:50%;cursor:pointer;font-size:.9rem;transition:color .2s,border-color .2s;width:auto;height:auto;}
    .product-wish:hover,.product-wish.active{color:#e05050;border-color:#e05050;}
    .product-badge{position:absolute;top:10px;left:10px;font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;padding:.2rem .6rem;border-radius:100px;font-weight:700;}
    .badge-new{background:rgba(212,132,58,.2);color:var(--amber);border:1px solid rgba(212,132,58,.3);}
    .product-img-wrap{width:100%;height:180px;overflow:hidden;background:var(--surface);display:flex;align-items:center;justify-content:center;}
    .product-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease;}
    .product-card:hover .product-img-wrap img{transform:scale(1.05);}
    .product-img-placeholder{font-size:3rem;opacity:.2;}
    .product-body{padding:1rem;}
    .product-cat{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--amber);margin-bottom:.3rem;}
    .product-name{font-family:var(--font-display);font-size:1.1rem;color:var(--cream);margin-bottom:.2rem;line-height:1.2;}
    .product-vendor{font-size:.7rem;color:var(--muted);margin-bottom:.8rem;}
    .product-footer{display:flex;align-items:center;justify-content:space-between;}
    .product-price{font-family:var(--font-display);font-size:1.3rem;font-weight:600;color:var(--amber);}
    .btn-cart{background:var(--amber);color:var(--bg);border:none;padding:.4rem .9rem;border-radius:6px;font-family:var(--font-body);font-size:.72rem;font-weight:600;cursor:pointer;transition:background .2s,transform .15s;width:auto;height:auto;}
    .btn-cart:hover{background:var(--amber-lt);transform:scale(1.05);}
    .btn-cart:disabled{background:var(--muted);cursor:not-allowed;transform:none;}

    /* ── EMPTY STATE ── */
    .empty-state{grid-column:1/-1;padding:5rem 2rem;text-align:center;color:var(--muted);}
    .empty-icon{font-size:3rem;margin-bottom:1rem;}
    .empty-state p{font-family:var(--font-display);font-size:1.5rem;color:var(--cream);margin-bottom:.5rem;}

    /* ── REVEAL ── */
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease;}
    .reveal.in-view{opacity:1;transform:none;}

    /* ✅ Ensure product cards are always visible */
    .product-card.reveal { opacity: 1 !important; transform: none !important; }

    @media(max-width:1024px){.layout{grid-template-columns:1fr;}.sidebar{position:static;}}
    @media(max-width:768px){.layout{padding:1rem;}.cat-strip{gap:.5rem;}}
  </style>
</head>

<body>

  <div class="cursor" id="cursor">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
  </div>

  <header>
    <nav class="navbar">
      <a href="/" class="nav-brand">Vend<span>◆</span>ra</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/track">Track Order</a></li>
        <li><a href="/cart">Cart (<span id="cart-count">0</span>)</a></li>
        <li><a href="/login">Login</a></li>
        <li><a href="/vendor/login" class="cta">Become Vendor</a></li>  <!-- ✅ fixed -->
      </ul>
    </nav>
  </header>

  <div class="page-hero">
    <div class="page-hero-grid"></div>
    <div class="page-hero-eyebrow">All Products</div>
    <h1>Discover <em>Everything</em></h1>
    <p class="page-hero-sub">
      Thousands of curated products from independent vendors — filtered just for you.
    </p>
  </div>

  <div class="toolbar-wrap">
    <div class="toolbar">
      <div class="search-wrap">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          style="position:absolute;left:.9rem;top:50%;transform:translateY(-50%);color:#7a7068;pointer-events:none">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input class="search-input" type="text" placeholder="Search products…" id="search-input" />
      </div>
      <select class="sort-select" id="sort-select">
        <option value="">Sort: Featured</option>
        <option value="price-asc">Price: Low → High</option>
        <option value="price-desc">Price: High → Low</option>
        <option value="name-asc">Name: A → Z</option>
      </select>
      <div class="result-count">
        Showing <span id="count"><%= products.length %></span> products
      </div>
    </div>
  </div>

  <div class="layout">

    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-heading">Category</div>
        <div class="cat-list">
          <a href="/products"
            class="cat-item <%= !locals.category ? 'active' : '' %>">All Products</a>
          <a href="/products?category=Electronics"
            class="cat-item <%= locals.category === 'Electronics' ? 'active' : '' %>">Electronics</a>
          <a href="/products?category=Clothing"
            class="cat-item <%= locals.category === 'Clothing' ? 'active' : '' %>">Clothing</a>
          <a href="/products?category=Books"
            class="cat-item <%= locals.category === 'Books' ? 'active' : '' %>">Books</a>
          <a href="/products?category=Home+%26+Kitchen"
            class="cat-item <%= locals.category === 'Home & Kitchen' ? 'active' : '' %>">Home & Kitchen</a>
          <a href="/products?category=Accessories"
            class="cat-item <%= locals.category === 'Accessories' ? 'active' : '' %>">Accessories</a>
          <a href="/products?category=Food+%26+Beverages"
            class="cat-item <%= locals.category === 'Food & Beverages' ? 'active' : '' %>">Food & Beverages</a>
          <a href="/products?category=Sports"
            class="cat-item <%= locals.category === 'Sports' ? 'active' : '' %>">Sports</a>
          <a href="/products?category=Beauty"
            class="cat-item <%= locals.category === 'Beauty' ? 'active' : '' %>">Beauty</a>
          <a href="/products?category=Toys"
            class="cat-item <%= locals.category === 'Toys' ? 'active' : '' %>">Toys</a>
        </div>
      </div>

      <div class="sidebar-section">
        <div class="sidebar-heading">Price Range</div>
        <input type="range" class="price-slider" min="0" max="10000"
          value="10000" id="price-range" />
        <div class="price-labels">
          <span>₹0</span>
          <span id="price-max-label">Up to ₹10,000</span>
        </div>
      </div>
    </aside>

    <main>
      <div class="cat-strip">
        <a href="/products?category=Electronics" class="cat-card">
          <div class="cat-card-icon">📱</div>
          <div class="cat-card-label">Electronics</div>
        </a>
        <a href="/products?category=Clothing" class="cat-card">
          <div class="cat-card-icon">👗</div>
          <div class="cat-card-label">Clothing</div>
        </a>
        <a href="/products?category=Books" class="cat-card">
          <div class="cat-card-icon">📚</div>
          <div class="cat-card-label">Books</div>
        </a>
        <a href="/products?category=Home+%26+Kitchen" class="cat-card">
          <div class="cat-card-icon">🏠</div>
          <div class="cat-card-label">Home & Kitchen</div>
        </a>
        <a href="/products?category=Accessories" class="cat-card">
          <div class="cat-card-icon">💎</div>
          <div class="cat-card-label">Accessories</div>
        </a>
        <a href="/products?category=Sports" class="cat-card">
          <div class="cat-card-icon">⚽</div>
          <div class="cat-card-label">Sports</div>
        </a>
        <a href="/products?category=Beauty" class="cat-card">
          <div class="cat-card-icon">💄</div>
          <div class="cat-card-label">Beauty</div>
        </a>
      </div>

      <div class="product-grid" id="product-list">
        <% if (products.length === 0) { %>
          <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <p>No products found</p>
            <span>Try a different category or search term.</span>
          </div>
        <% } %>

        <% products.forEach((product, i) => { %>
          <div class="product-card reveal" style="transition-delay:<%= (i % 12) * 55 %>ms">

            <button class="product-wish" onclick="toggleWish(this)" title="Wishlist">♡</button>

            <% if (i < 3) { %>
              <span class="product-badge badge-new">New</span>
            <% } %>

            <div class="product-img-wrap">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
              <% } else { %>
                <div class="product-img-placeholder">🛍</div>
              <% } %>
            </div>

            <div class="product-body">
              <div class="product-cat"><%= product.category || 'Product' %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="product-vendor">by <%= product.shopName || 'Independent Vendor' %></div>
              <div class="product-footer">
                <div class="product-price">₹<%= product.price.toLocaleString('en-IN') %></div>
                <button class="btn-cart"
                  onclick="handleAddToCart(this, '<%= product._id %>')">
                  Add to Cart
                </button>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    </main>

  </div>

  <footer>
    <div class="footer-inner">
      <div class="footer-brand">Vend<span>◆</span>ra</div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/vendor/login">Vendors</a>   <!-- ✅ fixed -->
        <a href="/track">Track</a>
      </div>
      <div class="footer-copy">© 2026 Multi Vendor Marketplace</div>
    </div>
  </footer>

  <script src="/js/script.js"></script>

</body>
</html>