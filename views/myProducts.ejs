<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Products — Vendra</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg:       #0d0b09;
      --surface:  #141210;
      --card:     #1a1714;
      --border:   #2a2520;
      --amber:    #d4843a;
      --amber-lt: #e8a862;
      --amber-dk: #a85f1e;
      --cream:    #f0e8d8;
      --muted:    #7a7068;
      --white:    #f8f4ee;
      --error:    #e05050;
      --green:    #4caf7d;
      --font-display: 'Cormorant Garamond', serif;
      --font-body:    'DM Sans', sans-serif;
      --ease: cubic-bezier(.22,.68,0,1.2);
    }

    body {
      background: var(--bg);
      color: var(--white);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.6;
      min-height: 100vh;
      cursor: none;
    }

    /* ── CURSOR ── */
    .cursor { position: fixed; top: 0; left: 0; z-index: 9999; pointer-events: none; }
    .cursor-dot {
      width: 7px; height: 7px; background: var(--amber);
      border-radius: 50%; transform: translate(-50%,-50%);
    }
    .cursor-ring {
      position: absolute; top: 0; left: 0;
      width: 32px; height: 32px;
      border: 1px solid rgba(212,132,58,.4); border-radius: 50%;
      transform: translate(-50%,-50%);
      transition: width .3s var(--ease), height .3s var(--ease), border-color .25s;
    }
    body:has(a:hover, button:hover) .cursor-ring {
      width: 46px; height: 46px; border-color: var(--amber);
    }

    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; opacity: .022; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    ::-webkit-scrollbar { width: 3px; }
    ::-webkit-scrollbar-thumb { background: var(--amber); border-radius: 2px; }

    /* ── NAVBAR ── */
    .navbar {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 2.5rem;
      background: rgba(13,11,9,.85);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }
    .nav-brand {
      font-family: var(--font-display); font-size: 1.4rem; font-weight: 600;
      color: var(--cream); text-decoration: none; letter-spacing: .02em;
    }
    .nav-brand span { color: var(--amber); }
    .nav-links { display: flex; align-items: center; gap: 1.5rem; }
    .nav-links a {
      font-size: .78rem; letter-spacing: .08em; text-transform: uppercase;
      color: var(--muted); text-decoration: none;
      transition: color .2s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--amber); }
    .nav-user {
      font-size: .78rem; color: var(--muted);
      display: flex; align-items: center; gap: .5rem;
    }
    .nav-user strong { color: var(--cream); }

    /* ── PAGE WRAPPER ── */
    .page { max-width: 1200px; margin: 0 auto; padding: 3rem 2rem; position: relative; z-index: 1; }

    /* ── PAGE HEADER ── */
    .page-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 2.5rem;
      animation: fadeUp .7s var(--ease) both;
    }
    .page-eyebrow {
      font-size: .62rem; letter-spacing: .16em; text-transform: uppercase;
      color: var(--amber); display: block; margin-bottom: .4rem;
    }
    .page-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 3.5vw, 3rem);
      font-weight: 300; color: var(--cream); line-height: 1.0;
    }
    .page-title em { font-style: italic; color: var(--amber); }

    .btn-add {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .7rem 1.4rem;
      background: var(--amber); color: var(--bg);
      border: none; border-radius: 7px;
      font-family: var(--font-body);
      font-size: .75rem; font-weight: 700;
      letter-spacing: .09em; text-transform: uppercase;
      text-decoration: none; cursor: pointer;
      transition: background .2s, transform .15s var(--ease), box-shadow .2s;
      box-shadow: 0 4px 16px rgba(212,132,58,.22);
    }
    .btn-add:hover {
      background: var(--amber-lt);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(212,132,58,.32);
    }

    /* ── STATS ROW ── */
    .stats-row {
      display: flex; gap: 1rem; margin-bottom: 2.5rem;
      animation: fadeUp .7s .08s var(--ease) both;
    }
    .stat-card {
      flex: 1;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.2rem 1.5rem;
    }
    .stat-label {
      font-size: .65rem; letter-spacing: .12em; text-transform: uppercase;
      color: var(--muted); margin-bottom: .3rem;
    }
    .stat-value {
      font-family: var(--font-display);
      font-size: 2rem; font-weight: 600; color: var(--cream);
    }
    .stat-value span { color: var(--amber); }

    /* ── FILTER BAR ── */
    .filter-bar {
      display: flex; align-items: center; gap: .75rem;
      margin-bottom: 2rem;
      animation: fadeUp .7s .12s var(--ease) both;
      flex-wrap: wrap;
    }
    .filter-label {
      font-size: .68rem; letter-spacing: .1em; text-transform: uppercase;
      color: var(--muted);
    }
    .filter-btn {
      padding: .35rem .9rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 100px;
      font-size: .72rem; color: var(--muted);
      cursor: pointer; transition: all .2s;
      font-family: var(--font-body);
    }
    .filter-btn:hover, .filter-btn.active {
      border-color: var(--amber);
      color: var(--amber);
      background: rgba(212,132,58,.08);
    }

    /* ── PRODUCT GRID ── */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.5rem;
      animation: fadeUp .7s .16s var(--ease) both;
    }

    .product-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color .25s, transform .2s var(--ease), box-shadow .25s;
      position: relative;
    }
    .product-card:hover {
      border-color: rgba(212,132,58,.35);
      transform: translateY(-4px);
      box-shadow: 0 12px 36px rgba(0,0,0,.35);
    }

    .product-img {
      width: 100%; height: 200px;
      object-fit: cover;
      display: block;
      background: var(--surface);
    }
    .product-img-placeholder {
      width: 100%; height: 200px;
      background: var(--surface);
      display: flex; align-items: center; justify-content: center;
      color: var(--muted); font-size: 2.5rem;
    }

    .product-badge {
      position: absolute; top: .75rem; right: .75rem;
      padding: .2rem .65rem;
      border-radius: 100px;
      font-size: .6rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    }
    .badge-active   { background: rgba(76,175,125,.15); border: 1px solid rgba(76,175,125,.3); color: var(--green); }
    .badge-inactive { background: rgba(224,80,80,.12);  border: 1px solid rgba(224,80,80,.25); color: var(--error); }

    .product-body { padding: 1.2rem; }

    .product-category {
      font-size: .6rem; letter-spacing: .12em; text-transform: uppercase;
      color: var(--amber); margin-bottom: .4rem;
    }
    .product-name {
      font-family: var(--font-display);
      font-size: 1.25rem; font-weight: 400; color: var(--cream);
      margin-bottom: .5rem; line-height: 1.2;
    }
    .product-price {
      font-size: 1.1rem; font-weight: 600; color: var(--amber);
      margin-bottom: 1rem;
    }
    .product-price span { font-size: .75rem; font-weight: 400; color: var(--muted); }

    .product-meta {
      display: flex; align-items: center; justify-content: space-between;
      font-size: .68rem; color: var(--muted);
      padding-top: .85rem;
      border-top: 1px solid var(--border);
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      grid-column: 1 / -1;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 5rem 2rem;
      text-align: center;
    }
    .empty-icon { font-size: 3.5rem; margin-bottom: 1.2rem; opacity: .4; }
    .empty-title {
      font-family: var(--font-display);
      font-size: 1.8rem; font-weight: 300; color: var(--cream);
      margin-bottom: .5rem;
    }
    .empty-sub { font-size: .85rem; color: var(--muted); margin-bottom: 1.5rem; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
      .page-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .stats-row { flex-direction: column; }
      .navbar { padding: 1rem 1.2rem; }
    }
  </style>
</head>

<body>

  <!-- CURSOR -->
  <div class="cursor" id="cursor">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
  </div>

  <!-- NAVBAR -->
  <nav class="navbar">
    <a href="/vendor" class="nav-brand">Vend<span>◆</span>ra</a>
    <div class="nav-links">
      <a href="/vendor">Dashboard</a>
      <a href="/vendor/my-products" class="active">My Products</a>
      <a href="/vendor/orders">Orders</a>
      <a href="/vendor/additem">Add Item</a>
    </div>
    <div class="nav-user">
      Hello, <strong><%= user?.name || user?.shopName || 'Vendor' %></strong>
      &nbsp;·&nbsp;
      <a href="/vendor/logout" style="color:var(--error);text-decoration:none;font-size:.75rem;">Logout</a>
    </div>
  </nav>

  <!-- PAGE -->
  <div class="page">

    <!-- HEADER -->
    <div class="page-header">
      <div>
        <span class="page-eyebrow">Inventory</span>
        <h1 class="page-title">My <em>Products</em></h1>
      </div>
      <a href="/vendor/additem" class="btn-add">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        Add Product
      </a>
    </div>

    <!-- STATS -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Total Products</div>
        <div class="stat-value"><span><%= products.length %></span></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Active</div>
        <div class="stat-value"><span><%= products.filter(p => p.isActive).length %></span></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Inactive</div>
        <div class="stat-value"><span><%= products.filter(p => !p.isActive).length %></span></div>
      </div>
    </div>

    <!-- FILTER -->
    <div class="filter-bar">
      <span class="filter-label">Filter:</span>
      <button class="filter-btn active" onclick="filterProducts('all', this)">All</button>
      <button class="filter-btn" onclick="filterProducts('active', this)">Active</button>
      <button class="filter-btn" onclick="filterProducts('inactive', this)">Inactive</button>
    </div>

    <!-- GRID -->
    <div class="product-grid" id="product-grid">

      <% if (products.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📦</div>
          <h2 class="empty-title">No products yet</h2>
          <p class="empty-sub">Start by adding your first product to the store.</p>
          <a href="/vendor/additem" class="btn-add">+ Add Your First Product</a>
        </div>
      <% } else { %>
        <% products.forEach(product => { %>
          <div class="product-card" data-status="<%= product.isActive ? 'active' : 'inactive' %>">

            <% if (product.isActive) { %>
              <span class="product-badge badge-active">Active</span>
            <% } else { %>
              <span class="product-badge badge-inactive">Inactive</span>
            <% } %>

            <% if (product.image) { %>
              <img src="<%= product.image %>" alt="<%= product.name %>" class="product-img"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
              <div class="product-img-placeholder" style="display:none;">📦</div>
            <% } else { %>
              <div class="product-img-placeholder">📦</div>
            <% } %>

            <div class="product-body">
              <div class="product-category"><%= product.category || 'General' %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="product-price">₹<%= product.price.toLocaleString('en-IN') %> <span>/ unit</span></div>
              <div class="product-meta">
                <span>Added <%= new Date(product.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
              </div>
            </div>

          </div>
        <% }) %>
      <% } %>

    </div>
  </div>

  <script>
    /* ── CURSOR ── */
    const cursorEl = document.getElementById('cursor');
    const dot  = cursorEl.querySelector('.cursor-dot');
    const ring = cursorEl.querySelector('.cursor-ring');
    let mx=0,my=0,rx=0,ry=0;
    document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; });
    (function anim() {
      dot.style.cssText  = `left:${mx}px;top:${my}px`;
      rx+=(mx-rx)*.13; ry+=(my-ry)*.13;
      ring.style.cssText = `left:${rx}px;top:${ry}px`;
      requestAnimationFrame(anim);
    })();

    /* ── FILTER ── */
    function filterProducts(status, btn) {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.product-card').forEach(card => {
        if (status === 'all' || card.dataset.status === status) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }
  </script>

</body>
</html>
